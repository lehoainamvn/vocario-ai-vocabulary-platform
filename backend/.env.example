# =========================================================================
# VOCARIO AI VISION & LLM SERVICE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials
# =========================================================================

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/vocario_db

# Security & JWT Authentication
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Vision Model Settings
YOLO_MODEL_PATH=yolov8s-worldv2.pt
CONFIDENCE_THRESHOLD=0.18

# Groq Cloud LLM API (Get key at: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=8
