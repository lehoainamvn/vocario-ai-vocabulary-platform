# CẤU HÌNH DATABASE POSTGRESQL CHO VOCARIO
# Thay đổi username, password, port và database name theo máy tính của bạn
DATABASE_URL=postgresql://postgres:123456@localhost:5432/vocario_db

# CẤU HÌNH APP / SECURITY
SECRET_KEY=vocario_super_secret_jwt_key_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI VISION & LLM CONFIG
YOLO_MODEL_PATH=yolov8s-worldv2.pt
CONFIDENCE_THRESHOLD=0.18
GROQ_API_KEY=gsk_your_groq_api_key_here
